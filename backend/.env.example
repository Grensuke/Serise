# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to Git!

# Server port (default: 4000)
PORT=4000

# MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=your_mongodb_connection_string_here

# JWT secret for signing tokens (use a strong random string)
# Generate: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Optional: OpenAI API key (if using OpenAI for AI features)
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Optional: Google Gemini API key (if using Gemini for AI features)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini REST endpoint (if not using default)
GEMINI_ENDPOINT=
